# Primer configa za sync.js. Kopirati u .env (van git-a) i popuniti.
# Vrednosti sa razmacima ili znakom # staviti pod navodnike: COMITUPIS_PASSWORD="ab#c d"

# lokalni test (sajt u Docker-u): http://localhost:8080/ppc-prenos-endpoint.php
PPC_ENDPOINT=https://pertinitoys.com/ppc-prenos-endpoint.php
# isti kao u public_html/ppc-prenos/config.php na sajtu
PPC_TOKEN=

COMITUPIS_HOST=192.168.0.101
COMITUPIS_PORT=1433
# prazno = podrazumevana instanca
COMITUPIS_INSTANCE=
COMITUPIS_DATABASE=ComitUPIS
COMITUPIS_USER=comit
COMITUPIS_PASSWORD=
# 1 = šifrovana veza (podrazumevano); server ima samopotpisan sertifikat, pa TRUST_CERT ostaje 1
COMITUPIS_ENCRYPT=1
COMITUPIS_TRUST_CERT=1

# samo za test: TEST- (u COMITUPIS ide TEST-58051); na produkciji uvek prazno
PREFIKS_BROJA=
# najviše poziva „spremne“ po jednom pokretanju
MAX_KRUGOVA=20
