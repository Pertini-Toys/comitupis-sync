# Example config for sync.js. Copy to .env (kept out of git) and fill in.
# Quote values that contain spaces or #: COMITUPIS_PASSWORD="ab#c d"

# local test (site in Docker): http://localhost:8080/ppc-prenos-endpoint.php
PPC_ENDPOINT=https://pertinitoys.com/ppc-prenos-endpoint.php
# same as in public_html/ppc-prenos/config.php on the site
PPC_TOKEN=

COMITUPIS_HOST=192.168.0.101
COMITUPIS_PORT=1433
# empty = default instance
COMITUPIS_INSTANCE=
COMITUPIS_DATABASE=ComitUPIS
COMITUPIS_USER=comit
COMITUPIS_PASSWORD=
# 1 = encrypted connection (default); the server has a self-signed certificate, so TRUST_CERT stays 1
COMITUPIS_ENCRYPT=1
COMITUPIS_TRUST_CERT=1

# test only: TEST- (COMITUPIS gets TEST-58051); always empty in production
PREFIKS_BROJA=
# maximum number of "spremne" calls per run
MAX_KRUGOVA=20
